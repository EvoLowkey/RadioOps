{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/runtime-config.js", "destination": "/api/runtime-config" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self)" }
      ]
    }
  ]
}
